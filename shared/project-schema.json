{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Video Editor Project",
  "type": "object",
  "required": ["version", "videoPath", "words", "segments", "deletedRanges", "language", "createdAt", "modifiedAt"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "videoPath": { "type": "string" },
    "sourceVideoPath": { "type": "string" },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "start", "end", "confidence"],
        "properties": {
          "word": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "confidence": { "type": "number" },
          "speaker": { "type": "string" },
          "clipId": { "type": "string" }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "text", "words"],
        "properties": {
          "id": { "type": "integer" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "text": { "type": "string" },
          "words": { "$ref": "#/properties/words" },
          "speaker": { "type": "string" },
          "clipId": { "type": "string" }
        }
      }
    },
    "deletedRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "wordIndices"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "cutStart": { "type": "number", "minimum": 0 },
          "cutEnd": { "type": "number", "minimum": 0 },
          "wordIndices": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "soundEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "start", "end", "confidence", "source", "overlapsSpeech", "markedForRemoval"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "const": "panns" },
          "overlapsSpeech": { "type": "boolean" },
          "markedForRemoval": { "type": "boolean" },
          "clipId": { "type": "string" }
        }
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "start", "duration"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "sourcePath": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "minimum": 0 }
        }
      }
    },
    "mediaFolders": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "broll": { "type": "string" },
        "music": { "type": "string" }
      }
    },
    "studioSoundEnabled": { "type": "boolean" },
    "mediaItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "start", "end", "volume"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["image", "broll", "music"] },
          "path": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "sourceStart": { "type": "number", "minimum": 0 },
          "volume": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "chatMessages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "text", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "role": { "enum": ["user", "assistant", "error"] },
          "text": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "plan": { "type": "object" }
        }
      }
    },
    "language": { "type": "string" },
    "playhead": { "type": "number", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "modifiedAt": { "type": "string", "format": "date-time" }
  }
}
