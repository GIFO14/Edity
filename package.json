{
  "name": "edity",
  "version": "0.1.0",
  "private": true,
  "description": "Edity — Open-source AI-powered text-based video editor",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 tcp:127.0.0.1:8643 && npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "electron .",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --port 8643",
    "build": "npm run build --prefix frontend && electron-builder",
    "build:mac": "npm run build --prefix frontend && electron-builder --mac dmg zip --universal",
    "lint": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "python-shell": "^5.0.0",
    "yauzl": "^2.10.0"
  },
  "build": {
    "appId": "io.github.gifo14.edity",
    "productName": "Edity",
    "directories": {
      "output": "dist/app"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "shared/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
